# Copy to .env and fill locally. NEVER commit .env or private keys.

PRIVATE_KEY=0xyour_deployer_private_key_here

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=your_etherscan_key

# Mainnet USDC (default in Deploy.s.sol if unset)
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Owner / royalty (often the same treasury)
INITIAL_OWNER=0xYourTreasuryAddress
ROYALTY_RECEIVER=0xYourRoyaltyAddress

# Trailing slash required for tokenURI concat
BASE_URI=ipfs://YOUR_CID/
